# Coding Plan Gateway Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# Configuration Paths
CONFIG_PATH=/app/config/plans.yaml
QUOTA_STATE_PATH=/app/data/quota-state.json

# Security
# Generate a secure random 32-byte key (hex encoded)
# Example: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here

# Quota Synchronization
# Interval in milliseconds for persisting quota state
QUOTA_SYNC_INTERVAL=60000

# API Key Management
API_KEYS_PATH=/app/data/api-keys.json
USAGE_DATA_PATH=/app/data/usage-data.json
AUTH_EXEMPT_PATHS=/health,/ready
USAGE_SYNC_INTERVAL=60000

# Enable Authentication (set to 'false' to disable)
ENABLE_AUTH=true