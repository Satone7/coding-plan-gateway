# Coding Plan Gateway Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# Configuration Paths
CONFIG_PATH=/app/config.yaml
QUOTA_STATE_PATH=/app/data/quota-state.json
PLAN_USAGE_DATA_PATH=/app/data/plan-usage-data.json

# Security
# Generate a secure random 32-byte key (hex encoded)
# Example: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here

# Quota Synchronization
# Interval in milliseconds for persisting quota state
QUOTA_SYNC_INTERVAL=60000

# API Key Management
API_KEYS_PATH=/app/data/api-keys.json
USAGE_DATA_PATH=/app/data/usage-data.json
USAGE_SYNC_INTERVAL=60000

# Enable Authentication (set to 'false' to disable)
ENABLE_AUTH=true

# E2E Configuration
# E2E uses a generated config file at e2e/test-config.yaml and a dedicated Claude Code home.
E2E_GATEWAY_PORT=8081
# Optional dedicated encryption key for Docker E2E. Falls back to ENCRYPTION_KEY when unset.
E2E_ENCRYPTION_KEY=

# Upstream provider API keys for real E2E coverage.
# Leave a value empty to skip that provider's real-request test.
ZHIPU_API_KEY=
VOLCENGINE_API_KEY=
ALI_API_KEY=
DEEPSEEK_API_KEY=

# NVIDIA coverage (two distinct scenarios):
#  - NVIDIA_API_KEY: nvapi- key for the OpenAI-only direct path
#    (gateway → integrate.api.nvidia.com). Drives nvidia-openai-direct.test.ts.
#  - LITELLM_MASTER_KEY: master key of the LiteLLM converter (Anthropic↔OpenAI)
#    fronting NVIDIA, so Claude Code can reach NVIDIA via the gateway.
#    Drives the nvidia-litellm plan in claude-code-providers.test.ts.
NVIDIA_API_KEY=
LITELLM_MASTER_KEY=
