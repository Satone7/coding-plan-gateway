+# Docker Compose: HTTPS Token Authentication
+# Usage: docker-compose -f docker-compose.https.yml up -d
+#
+# This configuration uses HTTPS with a personal access token for authentication.
+# Recommended for CI/CD environments and simple deployments.
+
+version: '3.8'
+
+services:
+  gateway:
+    build:
+      context: ../../..
+      dockerfile: docker/autoupdate/Dockerfile.autoupdate
+    image: coding-plan-gateway:autoupdate
+    container_name: cpg-gateway-https
+
+    environment:
+      # Auto-update configuration
+      - AUTOUPDATE_ENABLED=true
+      - AUTOUPDATE_BRANCH=master
+      - AUTOUPDATE_GIT_URL=${AUTOUPDATE_GIT_URL:?Error: AUTOUPDATE_GIT_URL not set}
+      - AUTOUPDATE_GIT_TOKEN=${AUTOUPDATE_GIT_TOKEN:?Error: AUTOUPDATE_GIT_TOKEN not set}
+      - AUTOUPDATE_MAX_RETRIES=3
+      - AUTOUPDATE_BACKUP_ENABLED=true
+
+      # Health check configuration
+      - AUTOUPDATE_HEALTH_URL=http://localhost:8080/health
+      - AUTOUPDATE_HEALTH_TIMEOUT=30
+      - AUTOUPDATE_HEALTH_RETRIES=15
+
+      # Logging
+      - LOG_LEVEL=info
+
+      # Application configuration
+      - NODE_ENV=production
+      - PORT=8080
+
+    volumes:
+      # Configuration file (read-only)
+      - ./config.yaml:/app/config.yaml:ro
