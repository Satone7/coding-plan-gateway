{
  "name": "coding-plan-gateway",
  "version": "1.0.0",
  "description": "A load balancer for managing multiple AI coding plan subscriptions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cpg": "./bin/cpg"
  },
  "scripts": {
    "build": "tsc && tsc-alias && npm run build:dashboard",
    "build:dashboard": "esbuild src/dashboard/index.tsx --bundle --platform=node --format=esm --outfile=dist/dashboard.mjs --external:react --external:ink --external:bcrypt --external:proper-lockfile",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "config:validate": "ts-node scripts/validate-config.ts",
    "reload": "curl -s -X POST http://localhost:8080/api/reload",
    "cpg": "node bin/cpg",
    "key:create": "ts-node scripts/api-key.ts create",
    "key:list": "ts-node scripts/api-key.ts list",
    "key:disable": "ts-node scripts/api-key.ts disable",
    "key:enable": "ts-node scripts/api-key.ts enable",
    "key:delete": "ts-node scripts/api-key.ts delete",
    "usage:report": "ts-node scripts/api-key.ts report",
    "e2e:start": "bash scripts/e2e/start.sh",
    "e2e:stop": "bash scripts/e2e/stop.sh",
    "e2e:reset": "bash scripts/e2e/reset.sh",
    "e2e:logs": "docker-compose -f docker-compose.e2e.yml logs -f",
    "e2e:status": "bash scripts/e2e/status.sh",
    "dashboard": "npm run build:dashboard && node dist/dashboard.mjs"
  },
  "keywords": [
    "ai",
    "gateway",
    "load-balancer",
    "openai",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "ink": "^6.8.0",
    "ink-table": "^3.1.0",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/ink-table": "^1.0.7",
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "msw": "^2.3.0",
    "prettier": "^3.3.2",
    "react-devtools-core": "^7.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
