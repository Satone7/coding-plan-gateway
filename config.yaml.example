# Coding Plan Gateway Configuration
version: 2

# Provider presets override (optional)
# Override built-in defaults or add custom providers.
# Built-in providers: zhipu, volcengine, ali, deepseek
#
# providers:
#   zhipu:
#     baseUrl: https://custom-zhipu-proxy.example.com
#     models:
#       - glm-5.1
#       - glm-5-turbo
#   my-custom:
#     name: My Custom Provider
#     baseUrl: https://api.custom.com/v1
#     models: [model-a]
#     hasUsageApi: false
#
#   # Local LM Studio (dynamic model list). LM Studio serves both OpenAI
#   # (/v1/chat/completions) and Anthropic (/v1/messages) endpoints:
#   # - dynamicModels: fetch <openaiBaseUrl>/v1/models at startup and every
#   #   MODEL_SYNC_INTERVAL_MS ms (default 300000 = 5 min). Fetched models are kept
#   #   in memory only and are NEVER written back to this file.
#   # - modelsExclude: drop model IDs containing any of these substrings
#   #   (case-insensitive). Defaults to ["embed"] to filter out embedding models.
#   # - baseUrl is optional: omit it for OpenAI-only upstreams (Anthropic
#   #   /v1/messages requests are then NOT routed here); set it when the upstream
#   #   also exposes an Anthropic endpoint (as LM Studio does).
#   lm-studio:
#     name: LM Studio (Local)
#     baseUrl: http://127.0.0.1:1234         # optional: Anthropic /v1/messages
#     openaiBaseUrl: http://127.0.0.1:1234   # OpenAI /v1/chat/completions
#     dynamicModels: true
#     modelsExclude:
#       - embed
#     hasUsageApi: false

plans:
  # Example: Using a provider preset with usage API (no quota needed)
  # - id: 1
  #   name: My Zhipu Plan
  #   provider: zhipu
  #   apiKey: YOUR_ZHIPU_API_KEY_HERE

  # Example: Using a provider preset without usage API (quota required)
  # - id: 2
  #   name: My Volcengine Plan
  #   provider: volcengine
  #   apiKey: YOUR_ARK_API_KEY_HERE
  #   quota:
  #     limit: 90000
  #     period:
  #       type: monthly
  #       expiresOn: 1

  # Example: local LM Studio (dynamic models, OpenAI-only)
  # - id: 3
  #   name: LM Studio Local
  #   provider: lm-studio
  #   apiKey: YOUR_LM_STUDIO_TOKEN_HERE
  #   # quota omitted → unlimited; models omitted → fetched at runtime

  # Example: Fully manual plan (no provider preset)
  - id: 1
    name: Example Plan
    baseUrl: https://api.example.com/v1
    apiKey: YOUR_API_KEY_HERE
    models:
      - model-1
      - model-2
    quota:
      limit: 1000
      period:
        type: 5h
        windowHours: 5
        sliding: true
    timeout: 300
    status: active
    enable: true
